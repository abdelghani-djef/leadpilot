# Copy to .env.local (development) or .env (Docker) and fill in what you need.
# Every variable is optional: with none set, LeadPilot runs in offline demo mode.

# --- AI -------------------------------------------------------------------
# Your Groq API key (free tier at console.groq.com). Without it, the offline demo engine scores leads.
GROQ_API_KEY=
# auto = AI when a key is set, demo = never call the AI, ai = always call the AI
LEADPILOT_MODE=auto

# Describe the business the leads are for. This is what the AI scores against.
# BUSINESS_PROFILE="Nova Digital, a small studio that builds websites, online stores and AI automations..."
# Language for summaries and next steps shown to the owner. Replies always use the lead's language.
# OWNER_LANGUAGE=English

# --- Dashboard -------------------------------------------------------------
# Set a password to sign in to the dashboard (any username). Without it, the dashboard is
# public, read-only, and masks names and emails.
ADMIN_PASSWORD=

# --- Integrations -----------------------------------------------------------
# Every new lead is POSTed here as JSON (n8n, Make, Zapier, Google Apps Script, a CRM).
WEBHOOK_URL=
# Signs each webhook body: header X-LeadPilot-Signature: sha256=<HMAC-SHA256 hex>
WEBHOOK_SECRET=

# --- Demo safety ------------------------------------------------------------
# Show visitors the AI analysis after they submit (true for a demo, false for a real site).
SHOW_ANALYSIS_TO_VISITOR=true
# Maximum leads accepted per day across the whole site.
DAILY_LEAD_LIMIT=300
# Footer link shown on every page, e.g. your Upwork profile or a mailto: link.
NEXT_PUBLIC_CONTACT_URL=

# Where the SQLite database file lives (Docker mounts a volume here).
# DATA_DIR=./data
